Bootstrap: docker
From: astral/uv:0.10-python3.13-trixie-slim

# network_glm container.
#
# Debian trixie (glibc 2.41) so scipy/nilearn/numpy install from wheels — the
# reason a bare `uv sync` on Sherlock's CentOS 7 (glibc 2.17) nodes cannot build
# scipy (no manylinux2014 wheel; source build needs OpenBLAS/gfortran).
#
# FSL (lev2 randomise) and FreeSurfer 8.1 (mri_surf2surf surface smoothing) are
# NOT in this image — they are loaded via `ml` in the sbatch templates and bound
# in at runtime, exactly as the monolith does.
#
# Layering note (future shared analysis-base): the heavy scientific stack
# (numpy/scipy/nilearn/nibabel/pandas/matplotlib) is what network_qa /
# network_analysis / the generic QA tools also need. When we factor a shared
# base image, that layer moves to the base and this def becomes
# `From: <analysis-base>` + the network_glm-specific install below.

%files
    pyproject.toml /opt/network_glm/pyproject.toml
    README.md /opt/network_glm/README.md
    .python-version /opt/network_glm/.python-version
    src /opt/network_glm/src
    config /opt/network_glm/config

%post
    set -eux
    # git is needed for the git+ companion deps (network_qa / randomise-prep /
    # bold-reliability-movies); the slim base image ships without it.
    apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
    cd /opt/network_glm
    # Install network_glm + all deps (scipy/nilearn/statsmodels + git companions
    # network_qa / randomise-prep / bold-reliability-movies) into a baked-in venv,
    # mirroring the monolith def (venv at /opt/venv, uv pip install).
    uv venv /opt/venv
    UV_CACHE_DIR=/tmp/uv_cache uv pip install --python /opt/venv/bin/python .
    rm -rf /tmp/uv_cache
    # smoke: the scientific stack imports
    /opt/venv/bin/python -c "import scipy, nilearn, nibabel, pandas, numpy, statsmodels, network_qa; print('scientific stack OK')"

%environment
    export PATH=/opt/venv/bin:$PATH
    export PYTHONUNBUFFERED=1

%runscript
    exec network-glm "$@"

%labels
    org.r01network.package network_glm
    org.r01network.source neuro_workflow@246cdf7361ec5726e317430653a036b7941c6fa1
